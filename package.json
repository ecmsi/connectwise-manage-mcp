{
  "name": "@ecmsi/connectwise-manage-mcp",
  "version": "2.1.0",
  "description": "ConnectWise Manage (PSA) MCP server for Claude, maintained by ECMSI",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "connectwise-manage-mcp": "./dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "build:ui": "vite build && node scripts/embed-ui.mjs",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "pack:mcpb": "node scripts/pack-mcpb.js",
    "validate:mcpb": "mcpb validate manifest.json",
    "audit:prod": "npm audit --omit=dev --audit-level=moderate",
    "check": "npm run lint && npm run typecheck && npm run build && npm test && npm run audit:prod",
    "docs:matrix": "node scripts/generate-permission-matrix.mjs",
    "check:permissions": "node scripts/check-permissions.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ecmsi/connectwise-manage-mcp.git"
  },
  "keywords": [
    "mcp",
    "claude",
    "connectwise",
    "connectwise-manage",
    "psa",
    "msp"
  ],
  "author": "ECMSI",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/ecmsi/connectwise-manage-mcp/issues"
  },
  "homepage": "https://github.com/ecmsi/connectwise-manage-mcp#readme",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.31.0",
    "jose": "^6.2.12",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@modelcontextprotocol/ext-apps": "^2.0.3",
    "@types/node": "^26.6.4",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=20.18.1"
  },
  "allowScripts": {
    "esbuild@0.25.12": true
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  }
}
