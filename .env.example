# =============================================================================
# ConnectWise Manage MCP server (ECMSI fork) — environment
# =============================================================================
# Copy to .env, fill in, then: chmod 600 .env
# Nothing in this file goes in a client config, a compose file, a service
# unit or a shell history. Recreate the container (docker compose up -d) after
# editing; `docker compose restart` keeps the old environment.

# -----------------------------------------------------------------------------
# ConnectWise Manage API credentials (a dedicated, least-privilege API member)
# -----------------------------------------------------------------------------
# Company identifier (the short name used to log in)
CW_MANAGE_COMPANY_ID=

# API member key pair: System > Members > API Members > API Keys
CW_MANAGE_PUBLIC_KEY=
CW_MANAGE_PRIVATE_KEY=

# Client ID from https://developer.connectwise.com/ClientID
CW_MANAGE_CLIENT_ID=

# API base URL
#   Cloud NA (default): https://api-na.myconnectwise.net
#   Cloud EU:           https://api-eu.myconnectwise.net
#   Cloud AU:           https://api-au.myconnectwise.net
#   Self-hosted:        https://cwm.yourcompany.com  (the canonical origin; redirects are refused)
CW_MANAGE_URL=https://api-na.myconnectwise.net

# Leave unset. "false" disables certificate verification for every ConnectWise
# request and logs a security warning. For a private CA, keep verification on
# and set NODE_EXTRA_CA_CERTS=/path/to/ca-bundle.pem instead.
# CW_MANAGE_REJECT_UNAUTHORIZED=false

# -----------------------------------------------------------------------------
# What the model may do
# -----------------------------------------------------------------------------
# read-only (default): the 64 get/search/list/test tools only. Write tools are
#   not registered at all: not listed, not callable.
# write: all 90 tools, including create/update/delete on tickets, time entries,
#   contacts, companies, agreements, invoices and inventory adjustments.
# Ticket notes and descriptions are written by customers, so text the model
# reads can try to instruct it. Stay read-only unless a task needs writes.
CW_WRITE_MODE=read-only

# -----------------------------------------------------------------------------
# HTTP transport (the container sets MCP_TRANSPORT, MCP_HTTP_HOST, MCP_HTTP_PORT)
# -----------------------------------------------------------------------------
# For a non-Docker systemd install, uncomment these three:
# MCP_TRANSPORT=http
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=3101

# Static bearer token every client presents as "Authorization: Bearer <token>".
# Generate: openssl rand -hex 32   (at least 32 characters; placeholders are refused)
MCP_BEARER_TOKEN=

# Only when a signing gateway or proxy in front of this server adds an
# X-Gateway-S2S HMAC header. Not used on the ECMSI host; leave empty.
# MCP_S2S_SECRET=

# Requests per minute per client address on every path except /health.
# Default 120; 0 disables.
# MCP_RATE_LIMIT_PER_MINUTE=120

# Set when a reverse proxy (Caddy) is in front, so the rate limiter uses the
# X-Forwarded-For address. The compose file sets this already.
# MCP_TRUST_PROXY=1

# Local development only: start HTTP with no authentication, loopback only.
# MCP_ALLOW_INSECURE_DEV=1

# -----------------------------------------------------------------------------
# Entra ID OAuth 2.1 (optional; not used on the ECMSI host)
# -----------------------------------------------------------------------------
# See entra-app-registration.md. With this on, MCP_BEARER_TOKEN becomes the
# static fallback inside the OAuth flow.
# MCP_OAUTH_ENABLED=true
# MCP_SERVER_URL=https://cw-mcp.example.com
# AZURE_TENANT_ID=
# AZURE_CLIENT_ID=
# AZURE_AUDIENCE=api://<AZURE_CLIENT_ID>
# AZURE_REQUIRED_ROLE=CWM.Access

# -----------------------------------------------------------------------------
# Ticket card branding (optional)
# -----------------------------------------------------------------------------
# MCP_BRAND_NAME=
# MCP_BRAND_LOGO_URL=
# MCP_BRAND_PRIMARY_COLOR=
# MCP_BRAND_ACCENT_COLOR=

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
LOG_LEVEL=info
